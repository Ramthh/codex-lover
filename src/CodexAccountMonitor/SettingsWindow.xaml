<Window x:Class="CodexAccountMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Account Monitor settings"
        Width="760" Height="780" MinWidth="600" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome" Background="{DynamicResource ButtonBackgroundBrush}" Padding="{TemplateBinding Padding}"
                                Margin="0,0,5,0" CornerRadius="6,6,0,0" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource MintBrush}" />
                                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource PopupSelectionBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PopupHighlightTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource MintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}" />
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MintBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <Border Margin="1" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="Make the monitor work your way." Style="{StaticResource HelpText}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE8BB;" Style="{StaticResource IconButton}"
                        AutomationProperties.Name="Close settings" Click="CloseButton_OnClick" IsEnabled="{Binding CanEdit}" VerticalAlignment="Top" />
            </Grid>

            <TabControl Grid.Row="1" Margin="0,22,0,18" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0"
                        IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Settings categories">
                <TabItem Header="Accounts">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" Padding="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Rename and reorder accounts here. Account changes apply immediately." Style="{StaticResource HelpText}" Margin="0,0,0,14" />
                            <TextBlock Text="No accounts connected. Add your first account to see its usage here." Margin="0,0,0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HelpText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding Accounts.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Accounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FF151F28" BorderBrush="#FF33424D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,9">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SlotDisplay}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding EditableAlias, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"
                                                         Style="{StaticResource CompactTextBox}" AutomationProperties.Name="Account alias" Margin="0,0,10,0" />
                                                <Button Grid.Column="2" Content="Save name" Command="{Binding SaveAliasCommand}" Style="{StaticResource GlassButton}" Padding="10,6" />
                                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,10">
                                                    <TextBlock Text="{Binding MaskedEmail}" Style="{StaticResource HelpText}" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding Health}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="↑" Command="{Binding MoveUpCommand}" Style="{StaticResource GlassButton}" Padding="9,4" Margin="0,0,5,0" ToolTip="Move account up" AutomationProperties.Name="Move account up" />
                                                    <Button Content="↓" Command="{Binding MoveDownCommand}" Style="{StaticResource GlassButton}" Padding="9,4" Margin="0,0,14,0" ToolTip="Move account down" AutomationProperties.Name="Move account down" />
                                                    <Button Content="Reconnect" Command="{Binding ReauthenticateCommand}" Style="{StaticResource GlassButton}" Padding="10,4" />
                                                </StackPanel>
                                                <Button Grid.Row="2" Grid.Column="2" Content="Remove" Command="{Binding RemoveCommand}" Style="{StaticResource GlassButton}" Padding="10,4" Foreground="{DynamicResource DangerBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="＋ Add account" Command="{Binding AddAccountCommand}" Style="{StaticResource GlassButton}" HorizontalAlignment="Left" Margin="0,4,0,8" />
                            <TextBlock Text="Trial: two accounts for three days. Pro: unlimited saved accounts. Removing an account only removes it from this monitor." Style="{StaticResource HelpText}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Widget">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" Padding="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" />
                            <CheckBox Content="Comfortable spacing and larger text" IsChecked="{Binding ComfortableDensity}" />
                            <CheckBox Content="Solid background for easier reading" IsChecked="{Binding OpaqueBackground}" />
                            <TextBlock Text="Solid background removes transparency. Your transparency level is kept for later." Style="{StaticResource HelpText}" Margin="20,0,0,12" />
                            <DockPanel>
                                <TextBlock Text="Background opacity" FontSize="12.5" />
                                <TextBlock Text="{Binding WidgetOpacityPercent, StringFormat={}{0}%}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource MintBrush}" FontWeight="SemiBold" />
                            </DockPanel>
                            <Slider Minimum="35" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                    Value="{Binding WidgetOpacityPercent}" AutomationProperties.Name="Widget background opacity" Margin="0,8,0,4">
                                <Slider.Style><Style TargetType="Slider"><Style.Triggers><DataTrigger Binding="{Binding OpaqueBackground}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Slider.Style>
                            </Slider>
                            <TextBlock Text="Window position, width, and expanded layout are remembered automatically." Style="{StaticResource HelpText}" Margin="0,5,0,24" />
                            <TextBlock Text="DESKTOP BEHAVIOR" Style="{StaticResource SectionLabel}" />
                            <CheckBox Content="Keep above other windows" IsChecked="{Binding AlwaysOnTop}" />
                            <CheckBox Content="Click-through mode" IsChecked="{Binding ClickThrough}" />
                            <TextBlock Text="Use the tray menu to turn click-through off." Style="{StaticResource HelpText}" Margin="20,0,0,8" />
                            <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                            <CheckBox Content="Minimize to tray" IsChecked="{Binding MinimizeToTray}" />
                            <TextBlock Text="When disabled, minimizing uses the taskbar and closing exits the monitor after checking for running tasks." Style="{StaticResource HelpText}" Margin="20,0,0,22" />
                            <TextBlock Text="REFRESH" Style="{StaticResource SectionLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding RefreshMinuteOptions}" SelectedItem="{Binding RefreshIntervalMinutes}" Style="{StaticResource SettingsCombo}" Width="90" AutomationProperties.Name="Refresh interval in minutes" />
                                <TextBlock Text="minutes between automatic refreshes" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" />
                            </StackPanel>
                            <TextBlock Text="Manual refresh is always available on the widget." Style="{StaticResource HelpText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Notifications">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" Padding="0,0,8,0">
                        <StackPanel>
                            <CheckBox Content="Show desktop notifications" IsChecked="{Binding NotificationsEnabled}" FontSize="14" />
                            <TextBlock Text="Get an alert when an account needs attention or quota becomes available." Style="{StaticResource HelpText}" Margin="20,2,0,18" />
                            <StackPanel IsEnabled="{Binding NotificationsEnabled}">
                                <TextBlock Text="NOTIFY ME WHEN" Style="{StaticResource SectionLabel}" />
                                <CheckBox Content="Remaining quota is low" IsChecked="{Binding NotifyLowQuota}" />
                                <StackPanel IsEnabled="{Binding NotifyLowQuota}" Margin="20,2,0,16">
                                    <DockPanel>
                                        <TextBlock Text="Alert threshold" FontSize="12" />
                                        <TextBlock Text="{Binding LowQuotaThresholdPercent, StringFormat={}{0}% remaining}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource MintBrush}" FontSize="12" />
                                    </DockPanel>
                                    <Slider Value="{Binding LowQuotaThresholdPercent}" Minimum="1" Maximum="99" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,0" AutomationProperties.Name="Low quota remaining percentage threshold" />
                                </StackPanel>
                                <CheckBox Content="An account needs sign-in again" IsChecked="{Binding NotifyAuthenticationExpired}" />
                                <CheckBox Content="Quota becomes available after a reset" IsChecked="{Binding NotifyQuotaRecovered}" />
                                <TextBlock Text="QUIET HOURS" Style="{StaticResource SectionLabel}" Margin="0,24,0,10" />
                                <CheckBox Content="Pause notifications during quiet hours" IsChecked="{Binding QuietHoursEnabled}" />
                                <StackPanel Orientation="Horizontal" IsEnabled="{Binding QuietHoursEnabled}" Margin="20,8,0,0">
                                    <ComboBox ItemsSource="{Binding HourOptions}" SelectedValue="{Binding QuietHoursStartHour}" SelectedValuePath="Value" DisplayMemberPath="Display" Width="105" Style="{StaticResource SettingsCombo}" AutomationProperties.Name="Quiet hours start time" />
                                    <TextBlock Text="to" VerticalAlignment="Center" Margin="14,0" />
                                    <ComboBox ItemsSource="{Binding HourOptions}" SelectedValue="{Binding QuietHoursEndHour}" SelectedValuePath="Value" DisplayMemberPath="Display" Width="105" Style="{StaticResource SettingsCombo}" AutomationProperties.Name="Quiet hours end time" />
                                </StackPanel>
                                <TextBlock Text="Uses your computer's local time. Quiet hours can continue past midnight." Style="{StaticResource HelpText}" Margin="20,10,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Connection">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" Padding="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="CODEX INSTALLATION" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="Use the official Codex app or CLI installed on this computer." Style="{StaticResource HelpText}" Margin="0,0,0,14" />
                            <TextBlock Text="Executable override (optional)" FontSize="12.5" Margin="0,0,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding CodexExecutablePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactTextBox}" Margin="0,0,8,0" AutomationProperties.Name="Codex executable override path" />
                                <Button Grid.Column="1" Content="Browse…" Style="{StaticResource GlassButton}" Click="BrowseCodex_OnClick" />
                            </Grid>
                            <TextBlock Text="Leave blank to detect Codex automatically." Style="{StaticResource HelpText}" Margin="0,8,0,16" />
                            <Button Content="Test connection" Command="{Binding TestConnectionCommand}" Style="{StaticResource GlassButton}" HorizontalAlignment="Left" />
                            <Border Background="#FF16242D" BorderBrush="#FF334A55" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding CodexExecutableStatus}" TextWrapping="Wrap" FontSize="12.5" AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock Text="{Binding DetectedCodexVersion, StringFormat='Version: {0}'}" Style="{StaticResource HelpText}" Margin="0,10,0,4" />
                                    <TextBlock Text="{Binding DetectedCodexPath}" Style="{StaticResource HelpText}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="The check verifies the signed executable and App Server support. It does not sign in or use your quota." Style="{StaticResource HelpText}" Margin="0,10,0,24" />
                            <Expander Header="Legacy credential cleanup" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Earlier builds could store an API key. This monitor does not run API tasks; no API key is needed." Style="{StaticResource HelpText}" />
                                    <TextBlock Text="{Binding ApiCredentialLabel}" Style="{StaticResource HelpText}" Margin="0,10,0,10" />
                                    <Button Content="Remove legacy API key" IsEnabled="{Binding HasStoredApiKey}" Style="{StaticResource GlassButton}" Click="RemoveApiKey_OnClick" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource WarningBrush}" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0" AutomationProperties.LiveSetting="Polite" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource GlassButton}" Margin="0,0,10,0" />
                    <Button Content="Save settings" IsEnabled="{Binding CanEdit}" Style="{StaticResource GlassButton}" BorderBrush="{DynamicResource MintBrush}" Click="SaveButton_OnClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
