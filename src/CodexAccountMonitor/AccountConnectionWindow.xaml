<Window x:Class="CodexAccountMonitor.AccountConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect Codex account"
        Width="620" Height="760" MinWidth="500" MinHeight="360" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" Background="#010D141C" Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Margin="1" Background="{DynamicResource ShellBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <TextBlock Text="{Binding Heading}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SlotLabel}" Foreground="{DynamicResource MintBrush}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,16">
            <StackPanel>
                <TextBlock Text="Your Google or X sign-in activates Codex Lover membership. Connect your Codex account separately here to see its usage. Accounts are never added automatically."
                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12.5" Margin="0,0,0,16" />
                <Border Visibility="{Binding HasSetup, Converter={StaticResource BoolToVisibility}}"
                        Background="{DynamicResource StatusPanelBrush}" BorderBrush="{DynamicResource MintBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,18"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}">
                    <StackPanel DataContext="{Binding Setup}">
                        <TextBlock Text="1. Check connection support" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Use your own eligible Codex account. A separate Codex desktop installation is only needed for Switch &amp; reopen."
                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,6,0,8" />
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12.5" />
                        <WrapPanel Margin="0,10,0,0" IsEnabled="{Binding CanChoosePath}">
                            <Button Content="Connection help ↗" Command="{Binding InstallGuideCommand}" Style="{StaticResource GlassButton}" Padding="8,5" Margin="0,0,6,6" />
                            <Button Content="Retry check" Command="{Binding RetryCommand}" Style="{StaticResource GlassButton}" Padding="8,5" Margin="0,0,6,6" />
                            <Button Content="Browse…" Click="BrowseCodex_OnClick" Style="{StaticResource GlassButton}" Padding="8,5" Margin="0,0,6,6" />
                            <Button Content="Use automatic detection" Command="{Binding AutoDetectCommand}" Style="{StaticResource GlassButton}" Padding="8,5" Margin="0,0,0,6" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="2. Connect your Codex account" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="Account name (for example, Personal or Work)" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6" />
                <TextBox Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactTextBox}" IsReadOnly="{Binding IsReauthentication}"
                         AutomationProperties.Name="Account alias" MaxLength="64" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}" />

                <TextBlock Text="Sign-in method" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,20,0,7" />
                <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}">
                    <RadioButton Content="Browser sign-in" IsChecked="{Binding UseDeviceCode, Converter={StaticResource InverseBoolean}}" />
                    <RadioButton Content="Device code" IsChecked="{Binding UseDeviceCode}" Margin="28,0,0,0" />
                </StackPanel>

                <Border Margin="0,18,0,0" Background="{DynamicResource StatusPanelBrush}" BorderBrush="#44525F69" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12.5" />
                        <Border Margin="0,12,0,0" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6" Padding="12,8"
                                Visibility="{Binding HasUserCode, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBox Text="{Binding UserCode, Mode=OneWay}" IsReadOnly="True" HorizontalContentAlignment="Center"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="20" FontWeight="SemiBold" BorderThickness="0"
                                         Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" AutomationProperties.Name="Device sign-in code" />
                                <Button Content="Copy code" Command="{Binding CopyCodeCommand}" Style="{StaticResource GlassButton}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <StackPanel Visibility="{Binding HasBrowserLink, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                            <TextBlock Text="{Binding VerificationSite}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Reopen browser" Command="{Binding OpenBrowserCommand}" Style="{StaticResource GlassButton}" Margin="0,0,8,0" />
                                <Button Content="Copy sign-in link" Command="{Binding CopyLinkCommand}" Style="{StaticResource GlassButton}" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="Codex handles authentication. This monitor never asks for or stores your password."
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Style="{StaticResource GlassButton}" Margin="0,0,10,0" />
                <Button Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}" IsDefault="True" Style="{StaticResource GlassButton}" BorderBrush="{DynamicResource MintBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
